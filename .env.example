SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=14
DATA_DIR=./data
WEBUNTIS_CLIENT=Untiplan
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3002
CLOUDFLARE_TUNNEL_TOKEN=

# Öffentliche Angaben für Impressum und Datenschutzerklärung
LEGAL_NAME=
LEGAL_STREET=
LEGAL_POSTAL_CODE=
LEGAL_CITY=
LEGAL_COUNTRY=Deutschland
LEGAL_EMAIL=

# Nur ausfüllen, wenn zutreffend
LEGAL_REPRESENTATIVE=
LEGAL_REGISTER=
LEGAL_REGISTER_NUMBER=
LEGAL_VAT_ID=
LEGAL_HOSTING_PROVIDER=
LEGAL_HOSTING_PRIVACY_URL=
LEGAL_USE_CLOUDFLARE=true

# Android/Google Play: Digital Asset Links für die Trusted Web Activity
ANDROID_PACKAGE_NAME=de.untiplan.app
# Fingerabdrücke durch Komma trennen; nach Play-App-Signing den Play-Fingerabdruck ergänzen
ANDROID_SHA256_CERT_FINGERPRINTS=
